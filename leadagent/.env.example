# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_KEY=change-this-long-random-string
# Model: default claude-opus-5-5. For lower cost per reply you can set claude-sonnet-5-5 or claude-haiku-5-5.
LEADAGENT_MODEL=claude-opus-5-5
LEADAGENT_EFFORT=low
LEADAGENT_DB=/data/leadagent.db
# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=any-random-string-you-also-type-into-meta
WHATSAPP_APP_SECRET=from-meta-app-dashboard
# One token per client, named in that client's tenants/<id>.json -> whatsapp.access_token_env
WA_TOKEN_DEMO_CLINIC=
